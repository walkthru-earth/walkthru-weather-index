# Copy this to .env and fill in values (never commit .env)

# ── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_JOB_NAMESPACE=walkthru-earth
HF_JOB_IMAGE=ghcr.io/walkthru-earth/walkthru-weather-index:latest
HF_JOB_FLAVOR=a10g-small

# ── AWS / S3 output ──────────────────────────────────────────────────────────
# Bare bucket name (no s3:// scheme, no trailing slash)
S3_BUCKET=your-output-bucket-name
# Key prefix inside the bucket — set this when IAM credentials are scoped
# to a specific prefix (e.g. "indices/v1"). Leave empty for bucket root.
S3_PREFIX=
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# ── Pipeline config overrides (all optional) ─────────────────────────────────
MODEL_NAME=GraphCast_GFS
H3_RESOLUTIONS=7,9
NOAA_FILE=
# Bounding box: min_lat,max_lat,min_lon,max_lon (empty = global)
BBOX=
